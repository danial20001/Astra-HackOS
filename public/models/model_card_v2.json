{
  "version": "noor-v2-leaf-only",
  "models": {
    "segmenter": {
      "file": "coffee_leaf.onnx",
      "input_size": 512,
      "classes": [
        "leaf"
      ],
      "note": "YOLO output has 4 box + 1 class + 32 mask channels; v1 38-channel decoder is incompatible."
    },
    "classifier": {
      "file": "coffee_cls_v2.onnx",
      "arch": "mobilenet_v3_small",
      "input_size": 224,
      "classes": [
        "brown_spot",
        "cercospora",
        "healthy",
        "miner",
        "rust"
      ],
      "temperature": 0.8,
      "preprocess": {
        "resize": [
          224,
          224
        ],
        "mean": [
          0.485,
          0.456,
          0.406
        ],
        "std": [
          0.229,
          0.224,
          0.225
        ],
        "color": "RGB",
        "layout": "NCHW float32"
      }
    }
  },
  "thresholds": {
    "seg_conf": 0.25,
    "conf_threshold": 0.7
  },
  "damage_estimate_supported": false,
  "metrics": {
    "bracot_leaf_mask_map50": 0.9718914395026302,
    "bracol_classifier": {
      "n": 120,
      "accuracy": 0.8916666507720947,
      "coverage": 0.949999988079071,
      "accepted_accuracy": 0.9298245906829834
    }
  },
  "limitations": [
    "No field disease ground truth evaluated",
    "No symptom segmentation or damage percentage",
    "Exact duplicates grouped; near duplicates/capture sessions not audited",
    "BRACOL mixed and unresolved rows excluded",
    "No target-phone runtime benchmark"
  ]
}